# Public site URL (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rate request emails via Resend (https://resend.com). Leave empty locally.
RESEND_API_KEY=
ENQUIRY_TO=
ENQUIRY_FROM=

# Local demo only: log rate requests to the server console instead of emailing,
# even under `next start`. Must NOT be set on the live site.
ENQUIRY_LOG_ONLY=1
